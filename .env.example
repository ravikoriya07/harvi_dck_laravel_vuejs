APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── News page: LinkedIn + Instagram auto-feed (server-side only) ─────────────
# Synced by `php artisan news:sync` (scheduled — requires the schedule:run cron).
# LinkedIn Community Management API; token scopes: r_organization_social, w_organization_social
LINKEDIN_ORGANIZATION_ID=53510973
LINKEDIN_ACCESS_TOKEN=
# Optional — enables automatic token refresh (approved LinkedIn partner apps only)
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
# development = LinkedIn's starting tier (100 API calls/day): LinkedIn is left out of the daily deep sync.
# Change to "standard" once LinkedIn approves the Standard tier.
LINKEDIN_API_TIER=development

# Instagram API with Instagram Login (Professional account); scope instagram_business_basic.
# Long-lived token — refreshed automatically before it expires.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v25.0

NEWS_SYNC_ENABLED=true
NEWS_SYNC_SCHEDULE="*/30 * * * *"
NEWS_SYNC_LIMIT=30
NEWS_SYNC_DEEP_SCHEDULE="15 3 * * *"
NEWS_SYNC_DEEP_LIMIT=300
NEWS_SYNC_MAX_DELETE_PERCENT=50
NEWS_SYNC_SUSPICIOUS_CONFIRMATIONS=3
