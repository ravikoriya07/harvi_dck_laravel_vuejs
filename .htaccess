<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to framework/application internals and dotenv files.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^(\.env|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.(js|ts)|phpunit\.xml)(\.dist)?$ - [F,L,NC]

    # If the request targets an existing file or directory in root, serve it directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other requests through Laravel's public front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>
